tmux/.config/tmux/plugins
tmux/.config/tmux/.last-session
tmux/.config/tmux/.session-history
tmux/.config/tmux/.session-dirs
tmux/.config/tmux/.live-sessions*
.claude/settings.local.json
hunk/.config/hunk/state.json
# Claude Code's cache of the skills on the claude.ai account, refreshed on
# login. It used to land here, because ~/.claude/skills was one stow symlink
# into this package and every write went straight to the checkout. That symlink
# is gone and the cache lives in a real ~/.claude/skills now. Kept as a guard
# for the day something stows skills/ again.
claude/.claude/skills/synced/
.docs/
.superpowers/
# ya pkg redownloads these, except ayu-mirage: it targets the Yazi 0.3 schema
# and is patched by hand here, so it is dropped from package.toml and kept.
yazi/.config/yazi/flavors/*
!yazi/.config/yazi/flavors/ayu-mirage.yazi
