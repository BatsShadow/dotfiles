(defcfg
  process-unmapped-keys yes
  delegate-to-first-layer yes
  ;;macos-dev-names-include (
  ;;  "Apple Internal Keyboard / Trackpad"
  ;;)
)
(include base.kbd)

(defalias
  ca (t! modtap a lctl left)
  as (t! modtap s lalt left)
  md (t! modtap d lmet left)
  sf (t! modtap f lsft left)

  sj (t! modtap j rsft right)
  mk (t! modtap k rmet right)
  al (t! modtap l lalt right)
  c; (t! modtap ; rctl right)

  fn (layer-while-held function)

  nspc (t! modtap spc (layer-while-held nav) right)

  colemak-dh (tap-dance 300 (lalt lrld-next))
)

(deflayer mac_base
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    _    _    _    _    _    _    _    _    _    _
  lctl @ca  @as  @md  @sf  _    _    @sj  @mk  @al  @c;
  _    _    _    _    _    _    _    _
  @fn       @colemak-dh    @nspc
)

(deflayer nomods
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    _    _    _    _    _    _    _    _    _    _
  lctl a    s    d    f    _    _    j    k    l    ;
  _    _    _    _    _    _    _    _
  @fn       @colemak-dh    _
)

(deflayer function
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _
  fn        _         _
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    left down up   right _
  _    _    _    _    _    _    _    _
  fn        _         _
)

