;; Cool stuff in here from:
;; https://gist.github.com/ldebritto/44574eac93148f387aaa560ccb131903
(defcfg
  process-unmapped-keys yes
  block-unmapped-keys no
  log-layer-changes no
  concurrent-tap-hold yes     ;; required to allow for combos and tap-hold-release features to coexist
  chords-v2-min-idle 350      ;; same as require-prior-idle from ZMK but only for for combos
  delegate-to-first-layer yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defvar
  ;; timings in ms using ZMK-like names
  one-shot-timeout 60000                 ;; 60 seconds. Bonkers, I know…
  tapping-term 250                       ;; A higher number allows for one handed modded keys reducing the chance of false-positives when typing fast
  quick-tap-ms 200                       ;; same as ZMK ($tap-repress-timeout in Kanata docs)
  require-prior-idle 150                 ;; same as ZMK (not used in vanilla kanata, but used as a workaround in this confit)  
  combo-timeout 60                       ;; same as ZMK
  
  ;; keys for tap-hold-release-tap-keys-release templates
  ;;
  ;; IMPORTANT: these lists are matched against PHYSICAL keys, i.e. the names in
  ;; defsrc -- not the Colemak letters this config outputs. (Per the kanata docs:
  ;; "The keys ... correspond to the physical input keys, or in other words the
  ;; key that corresponds to defsrc. This is in contrast to the fork and switch
  ;; actions which operates on outputted keys.")
  ;;
  ;; So each list below is written in defsrc coordinates, with the Colemak letter
  ;; it produces noted in the comment. Writing them as output letters silently
  ;; breaks things: physical p outputs ';', so listing 'p' as a left-side key made
  ;; shift (@t, on physical f) short-circuit to a tap and type "t;" instead of ":".
  left-side-keys   (q w e r t z x c v) ;; outputs: q w f p b  x c d v -- same-hand keys that force an early tap
  right-side-keys  (y u i o p h n m , . /) ;; outputs: j l u y ; m k h , . / -- same-hand keys that force an early tap
  home-row-left-keys  (a s d f g lsft b)   ;; outputs: a r s t g + z (shift) -- tap if released after the first key
  home-row-right-keys (j k l ;)            ;; outputs: n e i o             -- tap if released after the first key
)

;; home row mods templates mimicking urob's timerless home row mods implementation
(deftemplate lhrm (tappingterm tap-key hold-key)  ;; left hand mods
  (tap-hold-release-tap-keys-release $quick-tap-ms $tappingterm (multi $tap-key @tap) $hold-key $left-side-keys $home-row-left-keys)
)

(deftemplate rhrm (tappingterm tap-key hold-key)  ;; right hand mods
  (tap-hold-release-tap-keys-release $quick-tap-ms $tappingterm (multi $tap-key @tap) $hold-key $right-side-keys $home-row-right-keys)
)

(deftemplate nomod (tap-key)
  (multi $tap-key @tap)
)

(defalias
  ;; quasi-zmk's 'require-prior-idle' behavior
  tap (multi                                             
    (layer-switch nomods)                                ;; temporarily switches to a layer with no home row mods enabled
    (on-idle $require-prior-idle tap-virtualkey to-base) ;; when $require-prior-idle expires, uses the fake key to return to base layer (see )
  )

  ;; home row mods
  a (t! lhrm   $tapping-term   a  lctrl )
  r (t! lhrm   $tapping-term   r  lalt  )
  s (t! lhrm   $tapping-term   s  lmet  )
  t (t! lhrm   $tapping-term   t  lsft  )
  g (t! lhrm   $tapping-term   g (layer-while-held num) )
  z (t! lhrm   $tapping-term   z  lsft  )

  spc (t! lhrm $tapping-term   spc (layer-while-held nav) )
  
  n (t! rhrm   $tapping-term   n  rsft  )
  e (t! rhrm   $tapping-term   e  rmet  )
  i (t! rhrm   $tapping-term   i  lalt  )
  o (t! rhrm   $tapping-term   o  rctl  )

  ;; all the other alfas and def regular typing characters for require-prior-idle-like behavior as suggested by sgraar here (https://www.reddit.com/r/ErgoMechKeyboards/comments/1qosvc0/comment/o7cmdzd/)
  q (t! nomod q)
  w (t! nomod w)
  f (t! nomod f)
  p (t! nomod p)
  b (t! nomod b)

  m (t! nomod m)
  
  j (t! nomod j)
  l (t! nomod l)
  u (t! nomod u)
  y (t! nomod y)
  ; (t! nomod ;)

  x (t! nomod x)
  c (t! nomod c)
  d (t! nomod d)
  v (t! nomod v)

  k (t! nomod k)
  h (t! nomod h)
  , (t! nomod ,)
  . (t! nomod .)
  / (t! nomod /)

  fn (layer-while-held function)
  ;;nspc (tap-hold-release $tap-time $hold-time spc (layer-while-held nav))
)

(defvirtualkeys  
  to-base (layer-switch mac_base) ;; used in @tap alias to return to base layer on tap after hold-tap-release keys in an attempt to emulate ZMK require-prior-idle behavior
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  tab  q    w    e    r    t    y    u    i    o    p
  caps a    s    d    f    g    h    j    k    l    ;
  lsft z    x    c    v    b    n    m    ,    .    /
  fn        lalt      spc
)

(deflayer mac_base
  brdn brup mctl sls  _    _    prev pp   next mute vold  volu
  _    @q   @w   @f   @p   @b   @j   @l   @u   @y   @;
  esc  @a   @r   @s   @t   @g   @m   @n   @e   @i   @o
  @z   @x   @c   @d   @v   @z   @k   @h   @,   @.   @/
  @fn       _         @spc
)

(deflayer nomods
  brdn brup mctl sls  _    _    prev pp   next mute vold  volu
  _    q    w    f    p    b    j    l    u    y    ;
  esc  a    r    s   @t    g    m   @n    e    i    o
  z    x    c    d    v    z    k    h    ,    .    /
  @fn       _         _
)

(deflayer function
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  fn        _         _
)

;; TODO symbols too, then maybe num layer
(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _     _
  _    S-2  S-,  /    S-.  S-\  _    _    _    _    _
  _    S-1  S-9  S-0  -    S--  left down up  right _
  S-[  [    ]    S-]  _    _    _    _    _    _    _
  fn        _         _
)

(deflayer num
  _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    7    8    9    S-8
  _    _    _    _    _    _    =    4    5    6    -
  _    _    _    _    _    _    .    1    2    3    S-=
  fn        _         0
)
