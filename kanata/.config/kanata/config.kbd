;; Colemak-DH with home row mods.
;; Technique adapted from:
;; https://gist.github.com/ldebritto/44574eac93148f387aaa560ccb131903
(defcfg
  process-unmapped-keys yes
  block-unmapped-keys no
  log-layer-changes no
  concurrent-tap-hold yes     ;; lets combos and tap-hold-release coexist
  chords-v2-min-idle 350      ;; combos only

  ;; When any other physical key was pressed within this many ms, a tap-hold
  ;; resolves as its tap immediately and never enters the waiting state. This is
  ;; what keeps mods from firing during fast typing. ZMK calls it
  ;; require-prior-idle-ms.
  tap-hold-require-prior-idle 150

  delegate-to-first-layer yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
)

(defvar
  tapping-term 250   ;; hold timeout; higher allows one-handed mod chords at speed
  quick-tap-ms 200   ;; re-press within this window after a tap repeats the tap
)

;; Home row mod key lists, written once per hand and spliced into the templates
;; below. They live in a template rather than a defvar because kanata does not
;; expand $variables inside a named option list.
;;
;; IMPORTANT: these are matched against PHYSICAL keys -- the names in defsrc, not
;; the Colemak letters this config outputs. Physical p outputs ';', so listing p
;; as a left-side key makes shift (@t, on physical f) short-circuit to a tap and
;; type "t;" instead of ":". Each line notes what it outputs.
;;
;;   tap-on-press          side keys     -> tap as soon as the key is pressed
;;   tap-on-press-release  home row keys -> tap once pressed AND released
;;   any other key                       -> permissive hold
;;
;; This is why defhands/tap-hold-opposite-hand is not used despite being the
;; obvious fit: it offers a single (same-hand ...) policy for a whole hand and
;; cannot split one into the two tiers above.
(deftemplate lopts ()
  (tap-on-press         q w e r t z x c v)  ;; outputs: q w f p b  x c d v
  (tap-on-press-release a s d f g lsft b)   ;; outputs: a r s t g, z (shift), z
)

(deftemplate ropts ()
  (tap-on-press         y u i o p h n m , . /)  ;; outputs: j l u y ; m k h , . /
  (tap-on-press-release j k l ;)                ;; outputs: n e i o
)

(deftemplate lhrm (tappingterm tap-key hold-key)
  (tap-hold-keys $quick-tap-ms $tappingterm $tap-key $hold-key (t! lopts))
)

(deftemplate rhrm (tappingterm tap-key hold-key)
  (tap-hold-keys $quick-tap-ms $tappingterm $tap-key $hold-key (t! ropts))
)

;; Shift alone opts out of prior-idle suppression, so it stays holdable mid-burst.
(deftemplate lhrm-nopi (tappingterm tap-key hold-key)
  (tap-hold-keys $quick-tap-ms $tappingterm $tap-key $hold-key (t! lopts) (require-prior-idle 0))
)

(deftemplate rhrm-nopi (tappingterm tap-key hold-key)
  (tap-hold-keys $quick-tap-ms $tappingterm $tap-key $hold-key (t! ropts) (require-prior-idle 0))
)

;; Top-row keys that hold into the modnav layer, each supplying one modifier.
;; Their key lists differ from the hrm ones in both directions:
;;
;;   q w e r  hold-on-press, not tap-on-press, so a second one pressed inside the
;;            tapping term stacks its modifier instead of forcing an early tap
;;   u i h j k l m ,
;;            hold-on-press so an arrow fires and repeats on press rather than
;;            waiting for its release under permissive hold
(deftemplate navmod (tap-key hold-action)
  (tap-hold-keys $quick-tap-ms $tapping-term $tap-key $hold-action
    (tap-on-press         t z x c v)
    (tap-on-press-release a s d f g lsft b)
    (hold-on-press        q w e r u i h j k l m ,))
)

(defalias
  a (t! lhrm        $tapping-term   a  lctrl )
  r (t! lhrm        $tapping-term   r  lalt  )
  s (t! lhrm        $tapping-term   s  lmet  )
  t (t! lhrm-nopi   $tapping-term   t  lsft  )
  g (t! lhrm        $tapping-term   g (layer-while-held num) )
  z (t! lhrm-nopi   $tapping-term   z  lsft  )

  n (t! rhrm-nopi   $tapping-term   n  rsft  )
  e (t! rhrm        $tapping-term   e  rmet  )
  i (t! rhrm        $tapping-term   i  lalt  )
  o (t! rhrm        $tapping-term   o  rctl  )

  ;; Each holds into modnav carrying its own modifier, and modnav puts the same
  ;; four modifiers on the same four keys, so holding one and pressing another
  ;; stacks them: hold p for shift+arrows, add q for ctrl+shift+arrows.
  q (t! navmod q (multi lctrl (layer-while-held modnav)))
  w (t! navmod w (multi lalt  (layer-while-held modnav)))
  f (t! navmod f (multi lmet  (layer-while-held modnav)))
  p (t! navmod p (multi lsft  (layer-while-held modnav)))

  ;; Space is a thumb key and deliberately avoids the hrm templates. Those lists
  ;; split rolls from chords positionally (same hand = tap, other hand = hold),
  ;; which works for the alphas because the two sets are disjoint. For space they
  ;; are identical: every letter is both a roll partner (" the") and a nav chord
  ;; partner, so no list can separate them. Plain tap-hold-release separates them
  ;; by release order instead -- a roll releases space first (spc down, n down,
  ;; spc UP, n up) so it taps, while a chord nests the other key wholly inside
  ;; the hold (spc down, h down, h up, spc up) so it holds.
  spc (tap-hold-release $quick-tap-ms $tapping-term spc (layer-while-held nav))

  fn (layer-while-held function)
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  tab  q    w    e    r    t    y    u    i    o    p
  caps a    s    d    f    g    h    j    k    l    ;
  lsft z    x    c    v    b    n    m    ,    .    /
  fn        lalt      spc
)

(deflayer mac_base
  brdn brup mctl sls  _    _    prev pp   next mute vold  volu
  _    @q   @w   @f   @p   b    j    l    u    y    ;
  esc  @a   @r   @s   @t   @g   m    @n   @e   @i   @o
  @z   x    c    d    v    z    k    h    ,    .    /
  @fn       _         @spc
)

(deflayer function
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  _    _    _    _    lrld _    _    _    _    _    _   ;; fn+R reloads this config
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  fn        _         _
)

;; macOS screenshots: the rightmost column is full screen / selection / capture
;; UI, and physical y is selection straight to the clipboard.
(deflayer nav
  _    _    _    _    _    _    _       _    _    _     _     _
  _    S-2  S-,  /    S-.  S-\  M-C-S-4 _    _    _     M-S-3
  _    S-1  S-9  S-0  -    S--  left    down up   right M-S-4
  S-[  [    ]    S-]  _    _    _       S-;  _    _     M-S-5
  fn        _         _
)

(deflayer num
  _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    7    8    9    S-8
  _    _    _    _    _    _    =    4    5    6    -
  _    _    _    _    _    _    .    1    2    3    S-=
  fn        _         0
)

;; Arrow cluster sits where nav's does. The modifier comes from whichever key
;; held into this layer, so no modifier is baked into the arrows themselves; the
;; four here are for stacking a second and third one on top.
(deflayer modnav
  _    _    _    _    _    _    _    _    _    _    _     _
  _    lctrl lalt lmet lsft _   _    pgup home _    _
  _    _    _    _    _    _    left down up   right _
  _    _    _    _    _    _    _    pgdn end  _    _
  fn        _         _
)
