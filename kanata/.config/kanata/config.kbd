(defcfg process-unmapped-keys yes)

;; This technique is from
;; https://github.com/jtroo/kanata/discussions/1455#discussion-7766783
;;
;; What it effectively does is only enable modtap feature if a number of keys
;; have not been typed in rapid succession. This prevents modtap from
;; interfering with typing speed, but still allows for the modtap feature to be
;; used when the user is not typing quickly.
(deftemplate modtap (char mod)
  (switch 
    ((key-timing 3 less-than 250)) $char break
    () (tap-hold-release-timeout 200 500 $char $mod $char) break
  )
)

;; Home row mods QWERTY example with more complexity.
;; Some of the changes from the basic example:
;; - when a home row mod activates tap, the home row mods are disabled
;;   while continuing to type rapidly
;; - tap-hold-release helps make the hold action more responsive
;; - pressing another key on the same half of the keyboard
;;   as the home row mod will activate an early tap action

(defvar
  ;; Note: consider using different time values for your different fingers.
  ;; For example, your pinkies might be slower to release keys and index
  ;; fingers faster.
  tap-time 200
  hold-time 150

  left-hand-keys (
    q w e r t
    a s d f g
    z x c v b
  )
  right-hand-keys (
    y u i o p
    h j k l ;
    n m , . /
  )
  colemak-left-hand-keys (
    q w f p b
    a r s t g
    x c d v z
  )
  colemak-right-hand-keys (
    j l u y ;
    m n e i o
    k h , . /
  )
)

(deffakekeys
  to-base (layer-switch mac_base)
)

;; NOTE met == cmd
(defalias
  ;;ca (t! modtap a lctl)
  ;;as (t! modtap s lalt)
  ;;md (t! modtap d lmet)
  ;;sf (t! modtap f lsft)
  ;;
  ;;sj (t! modtap j rsft)
  ;;mk (t! modtap k rmet)
  ;;al (t! modtap l lalt)
  ;;c; (t! modtap ; rctl)
  
  ;;ar (t! modtap r lalt)
  ;;ms (t! modtap s lmet)
  ;;st (t! modtap t lsft)
  ;;
  ;;sn (t! modtap n rsft)
  ;;me (t! modtap e rmet)
  ;;ai (t! modtap i lalt)
  ;;co (t! modtap o rctl)

  tap (multi
    (layer-switch nomods)
    (on-idle-fakekey to-base tap 20)
  )

  ;; qwerty modtap
  ;; TODO can only use fancy hr mods for one base keyboard apparently
  ca (tap-hold-release-keys $tap-time $hold-time (multi a @tap) lctl $left-hand-keys)
  as (tap-hold-release-keys $tap-time $hold-time (multi s @tap) lalt $left-hand-keys)
  md (tap-hold-release-keys $tap-time $hold-time (multi d @tap) lmet $left-hand-keys)
  sf (tap-hold-release-keys $tap-time $hold-time (multi f @tap) lsft $left-hand-keys)

  sj (tap-hold-release-keys $tap-time $hold-time (multi j @tap) rsft $right-hand-keys)
  mk (tap-hold-release-keys $tap-time $hold-time (multi k @tap) rmet $right-hand-keys)
  al (tap-hold-release-keys $tap-time $hold-time (multi l @tap) lalt $right-hand-keys)
  c; (tap-hold-release-keys $tap-time $hold-time (multi ; @tap) rctl $right-hand-keys)

  ;; colemak modtap - TBD
  ;;cca (tap-hold-release-keys $tap-time $hold-time (multi a @ctap) lctl $colemak-left-hand-keys)
  ;;ar (tap-hold-release-keys $tap-time $hold-time (multi r @ctap) lalt $colemak-left-hand-keys)
  ;;ms (tap-hold-release-keys $tap-time $hold-time (multi s @ctap) lmet $colemak-left-hand-keys)
  ;;st (tap-hold-release-keys $tap-time $hold-time (multi t @ctap) lsft $colemak-left-hand-keys)
  ;;
  ;;sn (tap-hold-release-keys $tap-time $hold-time (multi n @ctap) rsft $colemak-right-hand-keys)
  ;;me (tap-hold-release-keys $tap-time $hold-time (multi e @ctap) rmet $colemak-right-hand-keys)
  ;;ai (tap-hold-release-keys $tap-time $hold-time (multi i @ctap) ralt $colemak-right-hand-keys)
  ;;co (tap-hold-release-keys $tap-time $hold-time (multi o @ctap) rctl $colemak-right-hand-keys)

  ;; simulate iso keyboard - left of z key for colemak-dh
  zs (tap-hold-release 200 500 z lsft)

  fn (layer-while-held function)

  colemak-dh (tap-dance 300 (lalt (layer-switch colemak_dh)))
  mac-base (tap-dance 300 (lalt (layer-switch mac_base)))
)

(defsrc
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  tab  q    w    e    r    t    y    u    i    o    p
  caps a    s    d    f    g    h    j    k    l    ;
  lsft z    x    c    v    b    n    m
  fn        lalt
)

(deflayer mac_base
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    _    _    _    _    _    _    _    _    _    _
  lctl @ca  @as  @md  @sf  _    _    @sj  @mk  @al  @c;
  _    _    _    _    _    _    _    _
  @fn       @colemak-dh
)

(deflayer nomods
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    _    _    _    _    _    _    _    _    _    _
  lctl a    s    d    f    _    _    j    k    l    ;
  _    _    _    _    _    _    _    _
  @fn       @colemak-dh
)

;; TODO use mods on colemak_dh
(deflayer colemak_dh
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    q    w    f    p    b    j    l    u    y    ;
  lctl a    r    s    t    g    m    n    e    i    o
  lsft x    c    d    v    z    k    h
  @fn       @mac-base
)

(deflayer function
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _
  fn        _
)

