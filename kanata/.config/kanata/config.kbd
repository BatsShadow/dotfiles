(defcfg
  process-unmapped-keys yes
  delegate-to-first-layer yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
    "NuPhy Air75 V3"
  )
)
(include base.kbd)

(defalias
  ca (t! modtap a lctl left)
  ar (t! modtap r lalt left)
  ms (t! modtap s lmet left)
  st (t! modtap t lsft left)

  sn (t! modtap n rsft right)
  me (t! modtap e rmet right)
  ai (t! modtap i lalt right)
  co (t! modtap o rctl right)

  sz (t! modtap z lsft left)

  fn (layer-while-held function)

  nspc (tap-hold-release $tap-time $hold-time spc (layer-while-held nav))
)

(deflayer mac_base
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    q    w    f    p    b    j    l    u    y    ;
  esc @ca  @ar  @ms  @st  g    m    @sn  @me  @ai  @co
  @sz  x    c    d    v    z    k    h
  @fn       _         @nspc
)

(deflayer nomods
  brdn brup _    _    _    _    prev pp   next mute vold  volu
  _    q    w    f    p    b    j    l    u    y    ;
  esc a    r    s    t    g    m    n    e    i    o
  z    x    c    d    v    z    k    h
  @fn       _         _
)

(deflayer function
  f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11   f12
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _
  fn        _         _
)

(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _     _
  _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    left down up   right _
  _    _    _    _    _    _    _    _
  fn        _         _
)

