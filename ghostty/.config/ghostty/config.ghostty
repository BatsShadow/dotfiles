background-opacity = 0.9
background-blur = 30

macos-titlebar-style = hidden

window-padding-x = 8
window-padding-y = 5,0

confirm-close-surface = false

font-family = Monaspace Neon NF
font-family = SauceCodePro Nerd Font Mono
font-style = Medium

font-family-bold = Monaspace Xenon NF
font-style-bold = ExtraBold

font-family-italic = Monaspace Argon NF
font-style-italic = Light Italic

# Upright, not slanted: bold+italic is how the prompt selects Krypton. The
# no-bold-italic stops Ghostty skewing it back. See NOTES.md.
font-family-bold-italic = Monaspace Krypton NF
font-style-bold-italic = Medium
font-synthetic-style = no-bold-italic

font-size = 14

adjust-cell-height = 32%

# ss01 left off: it is global-only and would ligate roman code text. See NOTES.md.
font-feature = calt
font-feature = liga

# Deliberately oversaturates the palette below. Not a correction. See NOTES.md.
window-colorspace = display-p3
alpha-blending = native

# Off by default in Ghostty, on by default in wezterm.
bold-is-bright = true

background = #151720
foreground = #bfbdb6

cursor-color = #e6b450
cursor-text = #0b0e14

selection-background = #409fff
selection-foreground = #0b0e14

palette = 0=#11151c
palette = 1=#ea6c73
palette = 2=#aad94c
palette = 3=#f9af4f
palette = 4=#53bdfa
palette = 5=#cda1fa
palette = 6=#90e1c6
palette = 7=#c7c7c7
palette = 8=#686868
palette = 9=#f07178
palette = 10=#d5ff80
palette = 11=#ffb454
palette = 12=#59c2ff
palette = 13=#d2a6ff
palette = 14=#95e6cb
palette = 15=#ffffff

# ---------------------------------------------------------------------------
# Keys
# ---------------------------------------------------------------------------
#
# Every binding fires unconditionally: Ghostty cannot check the foreground
# process, and tmux is always running. \x00 is Ctrl+Space, the tmux prefix.

# Readline word motion, matching Terminal.app. ESC b / ESC f.
keybind = opt+left=text:\x1bb
keybind = opt+right=text:\x1bf

# Line start / end. Ctrl+A and Ctrl+E.
keybind = cmd+left=text:\x01
keybind = cmd+right=text:\x05

# prefix C-k (tmux.conf:48), replacing Ghostty's own scrollback clear.
keybind = cmd+k=text:\x00\x0b

# prefix t = new-window (tmux.conf:41). prefix c is the Claude jumper now.
keybind = cmd+t=text:\x00t

# cmd+NUM switches tmux windows. The unbinds are required: Ghostty's own
# goto_tab uses the physical-key names, so without them both bindings fire.
keybind = cmd+digit_0=unbind
keybind = cmd+digit_1=unbind
keybind = cmd+digit_2=unbind
keybind = cmd+digit_3=unbind
keybind = cmd+digit_4=unbind
keybind = cmd+digit_5=unbind
keybind = cmd+digit_6=unbind
keybind = cmd+digit_7=unbind
keybind = cmd+digit_8=unbind
keybind = cmd+digit_9=unbind

keybind = cmd+zero=text:\x00\x30
keybind = cmd+one=text:\x00\x31
keybind = cmd+two=text:\x00\x32
keybind = cmd+three=text:\x00\x33
keybind = cmd+four=text:\x00\x34
keybind = cmd+five=text:\x00\x35
keybind = cmd+six=text:\x00\x36
keybind = cmd+seven=text:\x00\x37
keybind = cmd+eight=text:\x00\x38
keybind = cmd+nine=text:\x00\x39

# Shift+Enter newline for Claude Code, explicit rather than relying on kitty kbd.
keybind = shift+enter=csi:13;2u
